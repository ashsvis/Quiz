<Page x:Class="GuessMelody.PageEnding"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GuessMelody"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="PageEnding" Loaded="Page_Loaded">
    <Page.Background>
        <ImageBrush ImageSource="Backgrounds/Фон угадывания мелодии.jpg"/>
    </Page.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="70" FontFamily="Cambria" HorizontalAlignment="Right" Text="До новых встреч и праздников!" Margin="10"/>
        <MediaElement Grid.Row="2" Grid.Column="1" x:Name="videoPlayer" Width="1400" Height="780" Source="" LoadedBehavior="Manual" Visibility="Visible" />
    </Grid>
</Page>
