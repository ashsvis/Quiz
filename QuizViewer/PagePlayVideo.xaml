      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QuizViewer"
      mc:Ignorable="d" 
      d:DesignHeight="768" d:DesignWidth="1360"
      Title="PagePlayVideo">

    <Grid Margin="0" Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <MediaElement Source="" LoadedBehavior="Manual" Name="videoPlayer" />
        <MediaElement Source="" LoadedBehavior="Manual" Name="soundPlayer" />
    </Grid>
</Page>
