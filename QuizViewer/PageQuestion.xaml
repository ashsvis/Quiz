<Page x:Class="QuizViewer.PageQuestion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QuizViewer"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Вопрос">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Backgrounds/realistic-blue-paper-cut-background.jpg"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="ВИКТОРИНА" HorizontalAlignment="Left" TextWrapping="Wrap" TextAlignment="Left" 
                   Foreground="WhiteSmoke" FontFamily="Comic Sans MS" FontSize="24"/>
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Вопрос ... ?" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Justify" 
                   Foreground="White" FontFamily="Segoe UI" FontSize="24"/>
            <Image Grid.Row="1" Source="Backgrounds/Назад.png" />
        </Grid>
        <Grid Grid.Row="2" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="1" BorderThickness="1" BorderBrush="WhiteSmoke" CornerRadius="50" Padding="15" >
                <TextBlock Text="Ответ A" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Justify" 
                    Foreground="White" FontFamily="Segoe UI" FontSize="24"/>
            </Border>
            <Border Grid.Row="3" BorderThickness="1" BorderBrush="WhiteSmoke" CornerRadius="50" Padding="15" >
                <TextBlock Text="Ответ B" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Justify" 
                   Foreground="White" FontFamily="Segoe UI" FontSize="24"/>
            </Border>
            <Border Grid.Row="5" BorderThickness="1" BorderBrush="WhiteSmoke" CornerRadius="50" Padding="15" >
                <TextBlock Text="Ответ C" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Justify" 
                   Foreground="White" FontFamily="Segoe UI" FontSize="24"/>
            </Border>
            <Border Grid.Row="7" BorderThickness="1" BorderBrush="WhiteSmoke" CornerRadius="50" Padding="15" >
                <TextBlock Text="Ответ D" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Justify" 
                   Foreground="White" FontFamily="Segoe UI" FontSize="24"/>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="Вопрос 4 из 18" 
                   TextWrapping="Wrap" TextAlignment="Left" HorizontalAlignment="Stretch" 
                   Foreground="WhiteSmoke" FontFamily="Comic Sans MS" FontSize="12"/>
        <StackPanel Grid.Row="6" Grid.Column="0"  Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button x:Name="btnBack" Width="48" Height="48" Background="Transparent" ClipToBounds="True" SnapsToDevicePixels="True" BorderThickness="0"
                    Click="btnBack_Click" >
                <StackPanel Orientation="Horizontal" Visibility="Visible" >
                    <Image Source="Backgrounds/Назад.png" />
                </StackPanel>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="6" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button x:Name="btnForward" Width="48" Height="48" Background="Transparent" ClipToBounds="True" SnapsToDevicePixels="True" BorderThickness="0"
                    Click="btnForward_Click" >
                <StackPanel Orientation="Horizontal" Visibility="Visible" >
                    <Image Source="Backgrounds/Вперёд.png" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
